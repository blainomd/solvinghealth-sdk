{
  "name": "@solvinghealth/sdk",
  "version": "0.1.0",
  "description": "SolvingHealth SDK — unified re-export of all packages (FHIR, HIPAA, Clinical, Billing, PROM, Identity)",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@solvinghealth/billing": "0.1.0",
    "@solvinghealth/prom": "0.1.0",
    "@solvinghealth/identity": "0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
