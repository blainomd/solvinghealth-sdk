  "description": "Identity management — NPI validation, ComfortCard, W3C DID, Remote Online Notarization, WorkOS AuthKit, ABAC, and audit logging",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
